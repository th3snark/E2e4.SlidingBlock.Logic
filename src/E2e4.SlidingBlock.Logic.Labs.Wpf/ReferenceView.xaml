<UserControl x:Class="E2e4.SlidingBlock.Logic.Labs.Wpf.ReferenceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="H1" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,22,0,6"/>
        </Style>
        <Style x:Key="P" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="LineHeight" Value="21"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="Formula" TargetType="TextBlock" BasedOn="{StaticResource MonoText}">
            <Setter Property="Foreground" Value="{StaticResource Gold}"/>
            <Setter Property="Margin" Value="14,2,0,8"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="960" Margin="24,8,24,40" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource H1}" Text="Why three specialised 64-bit representations?"/>
            <TextBlock Style="{StaticResource P}" Text="Sliding-block puzzles are PSPACE-complete in general (Hearn &amp; Demaine, 2005), so solver throughput is dominated by state size, move-generation branching and transposition-table hash cost. Engines converge on three layouts, chosen by each piece's degrees of freedom."/>
            <TextBlock Style="{StaticResource P}" Text="1. Uniform N-puzzles (15-puzzle): 16 squares x 4 bits = 64 bits, one register. Sliding a tile into the blank is a branchless XOR; an inverse tile-to-square ulong gives O(1) pattern-database lookups (Korf &amp; Felner, 2002)."/>
            <TextBlock Style="{StaticResource P}" Text="2. Axis-constrained puzzles (Rush Hour): a car or truck can only move along its lane, so state is one 4-bit offset per vehicle (16 vehicles per 64-bit register, up to 64 in the garage form). Occupancy is rebuilt from a MaskAt(v, offset) table, and legality is a test of the cells the vehicle slides over against the other vehicles."/>
            <TextBlock Style="{StaticResource P}" Text="3. Unrestricted 2D pieces (Klotski, polyominoes): pieces move in two dimensions and many are identical. Tracking piece ids multiplies the state space by k! per class (4! x 4! = 576x in Klotski), and non-rectangular shapes add three hazards: empty bounding-box origins, asymmetric row wrap-around, and cell-encoding overflow beyond 7 shape classes or 21 cells."/>

            <TextBlock Style="{StaticResource H1}" Text="LSB normalisation: offsets are never negative"/>
            <TextBlock Style="{StaticResource P}" Text="Normalise every shape so its first occupied cell in row-major order is bit 0:"/>
            <TextBlock Style="{StaticResource Formula}" Text="BaseMask = rawMask >> BitOperations.TrailingZeroCount(rawMask)"/>
            <TextBlock Style="{StaticResource P}" Text="A cell can overhang to the left only on a strictly lower row (deltaRow >= 1), and every piece is narrower than the board (|deltaCol| &lt; W). Therefore"/>
            <TextBlock Style="{StaticResource Formula}" Text="deltaBit = deltaRow * W + deltaCol  >=  W - (W - 1)  >  0"/>
            <TextBlock Style="{StaticResource P}" Text="so every set bit of BaseMask sits at a non-negative index and bit 0 is always set. Placing a piece on any square is a single unsigned shift (BaseMask &lt;&lt; anchor), and recovering its anchor is a single instruction: anchor = tzcnt(pieceMask). The upward T-tetromino and the J-tromino therefore anchor on their top stem, not on their empty bounding-box corner."/>

            <TextBlock Style="{StaticResource H1}" Text="ValidAnchorsMask replaces sentinel walls"/>
            <TextBlock Style="{StaticResource P}" Text="For each group, precompute a mask with bit s set iff every cell of the shape, placed relative to anchor s, stays inside [0..H-1, 0..W-1] and off static walls, tested in 2D (row, col) coordinates. At run time one bit-test proves the shifted mask can neither wrap across rows nor enter a wall:"/>
            <TextBlock Style="{StaticResource Formula}" Text="((ValidAnchorsMask[g] >> nextAnchor) &amp; 1UL) != 0   =>   BaseMask[g] &lt;&lt; nextAnchor is safe"/>

            <TextBlock Style="{StaticResource H1}" Text="Register-only BFS for hook moves"/>
            <TextBlock Style="{StaticResource P}" Text="A piece's placement is identified by its single anchor bit, so all destinations reachable in one turn, including corner turns, come from a flood fill over anchors held in three 64-bit registers (frontier, visitedOrInvalid, reachable). Horizontal shifts are masked with column masks so +-1 never wraps a row; blocked anchors (overlapping other pieces or invalid) are pre-loaded into visitedOrInvalid."/>
            <TextBlock Style="{StaticResource Formula}" Text="visitedOrInvalid = ~free | (1UL &lt;&lt; start)&#x0a;next = ((frontier &lt;&lt; 1) &amp; notCol0) | ((frontier >> 1) &amp; notLastCol) | frontier &lt;&lt; W | frontier >> W&#x0a;next &amp;= ~visitedOrInvalid"/>

            <TextBlock Style="{StaticResource H1}" Text="Permutation-invariant Zobrist hashing"/>
            <TextBlock Style="{StaticResource P}" Text="Identical pieces share an EquivalenceGroupId, and the Zobrist table is indexed by group, not by piece:"/>
            <TextBlock Style="{StaticResource Formula}" Text="Hash ^= ZobristTable[g, oldAnchor] ^ ZobristTable[g, newAnchor]&#x0a;GroupAnchors[g] ^= (1UL &lt;&lt; oldAnchor) | (1UL &lt;&lt; newAnchor)"/>
            <TextBlock Style="{StaticResource P}" Text="Because XOR is commutative and associative, swapping two identical pieces XORs the same two keys in either order, so both GroupAnchors[g] and Hash are unchanged, with no sorting. GroupAnchors is also a lossless canonical encoding: bit s is set iff some piece of the group is anchored at s. Try the swap button in Lab 2."/>

            <TextBlock Style="{StaticResource H1}" Text="References"/>
            <TextBlock Style="{StaticResource P}" Text="Zobrist, A. L. (1970). A New Hashing Method with Application for Game Playing. Technical Report #88, Computer Sciences Department, University of Wisconsin."/>
            <TextBlock Style="{StaticResource P}" Text="Korf, R. E., &amp; Felner, A. (2002). Disjoint Pattern Database Heuristics. Artificial Intelligence, 134(1-2), 9-22."/>
            <TextBlock Style="{StaticResource P}" Text="Hearn, R. A., &amp; Demaine, E. D. (2005). PSPACE-Completeness of Sliding-Block Puzzles and Other Problems through the Nondeterministic Constraint Logic Model of Computation. Theoretical Computer Science, 343(1-2), 72-96."/>
            <TextBlock Style="{StaticResource P}" Text="Spaans, R. (2009) &amp; Fogleman, M. (2018). Solving Sliding-Block Puzzles / Rush Hour &amp; Klotski Bitboard Encodings. (Canonical cell-shape encoding, 1D lane-offset packing, bit-shift collision detection.)"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
