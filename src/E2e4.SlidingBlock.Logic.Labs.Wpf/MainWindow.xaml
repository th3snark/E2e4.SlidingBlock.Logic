<Window x:Class="E2e4.SlidingBlock.Logic.Labs.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:w="clr-namespace:E2e4.SlidingBlock.Logic.Labs.Wpf"
        xmlns:l1="clr-namespace:E2e4.SlidingBlock.Logic.Labs.Wpf.Lab1"
        xmlns:l2="clr-namespace:E2e4.SlidingBlock.Logic.Labs.Wpf.Lab2"
        Title="Sliding Puzzle Bitboard Laboratories" Width="1400" Height="920" MinWidth="1100" MinHeight="700"
        Background="{StaticResource Bg0}" Foreground="{StaticResource Fg}" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen" WindowState="Maximized">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="20,12">
            <StackPanel Orientation="Horizontal">
                <Border Background="#0C4A6E" CornerRadius="6" Width="34" Height="34" Margin="0,0,12,0">
                    <TextBlock Text="0x" FontFamily="{StaticResource Mono}" FontWeight="Bold" Foreground="{StaticResource Accent}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel>
                    <TextBlock Text="Sliding Puzzle Bitboard Laboratories" FontSize="17" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Text=".NET 10 / C# 14 - zero-allocation bitboard engine, LSB-normalised polyominoes, Zobrist group hashing"
                               Foreground="{StaticResource Muted}" FontSize="11"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <TabControl>
            <TabItem Header="Lab 1 - Standard Architectures"><l1:Lab1View/></TabItem>
            <TabItem Header="Lab 2 - Polyomino &amp; Hook Moves"><l2:Lab2View/></TabItem>
            <TabItem Header="Architecture &amp; Research Guide"><w:ReferenceView/></TabItem>
        </TabControl>
    </DockPanel>
</Window>
