<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Lets the Linux CI runners build (not run) the WPF project. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <IsPackable>false</IsPackable>
    <Product>E2e4 Sliding Block Labs</Product>
    <Description>WPF laboratories that show the E2e4.SlidingBlock.Logic bitboards and solvers at work.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\E2e4.SlidingBlock.Logic\Aliases.cs" Link="Aliases.cs" />
    <ProjectReference Include="..\E2e4.SlidingBlock.Logic\E2e4.SlidingBlock.Logic.csproj" />
  </ItemGroup>

</Project>
